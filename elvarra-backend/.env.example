# ============================================================
# Elvarra Backend — Environment Variables
# ============================================================
# Copy this to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/elvarra
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/elvarra
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/elvarra?retryWrites=true&w=majority


# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this_with_64_random_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_replace_this_too
JWT_REFRESH_EXPIRES_IN=30d

# ── Razorpay ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Cloudinary (design file uploads) ─────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (Nodemailer) ────────────────────────────────────────
# For Gmail: enable App Passwords at myaccount.google.com/security
# For production: use SendGrid / Resend / AWS SES
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Elvarra <no-reply@elvarra.com>"

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
