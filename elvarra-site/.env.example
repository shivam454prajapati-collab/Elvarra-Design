# ============================================================
# Elvarra — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore already.
# ============================================================

# ── Backend API ──────────────────────────────────────────────
# Your Node.js/Express backend URL
# Development:  http://localhost:5000/api
# Production:   https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# ── Razorpay ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_ keys during development, rzp_live_ for production
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com
# → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Add authorized origins: http://localhost:5173, https://yourdomain.com
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com

# ── App URL (for SEO / canonical links) ──────────────────────
VITE_APP_URL=https://elvarra.com
